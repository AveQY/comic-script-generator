async function fetchEpisodeText(file) {
  if (!file) return '';
  const p = currentProject;
  if (!p) return '';
  const cacheKey = p + '::' + file;
  if (episodeCache[cacheKey]) return episodeCache[cacheKey];

  const url = '/episode?project=' + encodeURIComponent(p) + '&file=' + encodeURIComponent(file);
  // /episode returns raw text or JSON with content field
  try {
    const resp = await fetch(url);
    if (!resp.ok) throw new Error('HTTP ' + resp.status);
    const ct = resp.headers.get('content-type') || '';
    let text;
    if (ct.includes('application/json')) {
      const json = await resp.json();
      text = json.content || json.text || json.body || JSON.stringify(json);
    } else {
      text = await resp.text();
    }
    episodeCache[cacheKey] = text;
    return text;
  } catch (e) {
    // Fallback: try /file endpoint
    const fallbackUrl = fileUrl(p, file);
    const resp = await fetch(fallbackUrl);
    if (!resp.ok) throw new Error('无法加载稿子');
    const text = await resp.text();
    episodeCache[cacheKey] = text;
    return text;
  }
}

