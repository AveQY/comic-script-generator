function filterProjects(projects, cat) {
  if (!cat || cat === 'all') return projects;
  return projects.filter(p => {
    const mode = p.content_mode || '';
    const category = (p.category || '').toLowerCase();
    const name = (p.name || '').toLowerCase();
    if (cat === 'comic') return mode !== 'light_novel';
    if (cat === 'novel') return mode === 'light_novel';
    // specific category match
    return category === cat.toLowerCase() || category.includes(cat.toLowerCase());
  });
}

function filterCategory(cat) {
  currentCategory = cat;
  // update sidebar active
  document.querySelectorAll('.sidebar-item').forEach(el => el.classList.remove('active'));
  const sidebarEl = document.querySelector('.sidebar-item[data-cat="' + cat + '"]');
  if (sidebarEl) sidebarEl.classList.add('active');
  renderHome();
}

