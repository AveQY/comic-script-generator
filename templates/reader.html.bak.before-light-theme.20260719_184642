    }
  }
  bindImages();
}

// ============================================================
//  IntersectionObserver for lazy images
// ============================================================
function ensureObserver() {
  if (observer) {
    observer.disconnect();
    observer = null;
  }
  observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const img = entry.target;
        const src = img.getAttribute('src');
        // Already loaded or has src
        if (img.classList.contains('loaded') || img.getAttribute('data-loaded') === '1') return;
        // If src is already set, just mark loaded
        if (src && src !== '') {
          img.classList.add('loaded');
          img.setAttribute('data-loaded', '1');
        }
        observer.unobserve(img);
      }
    });
  }, { rootMargin: '300px 400px 300px 400px' });
}

function bindImages() {
  ensureObserver();
  document.querySelectorAll('.lazy-img:not(.loaded)').forEach(img => {
    if (img.getAttribute('data-loaded') !== '1') {
      observer.observe(img);
    }
  });
}

