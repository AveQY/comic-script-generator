async function loadNovelChapter(index) {
  const novels = currentNovels;
  if (!novels || index < 0 || index >= novels.length) return;

  currentNovelIndex = index;
  const nv = novels[index];

  showLoading();
  try {
    const url = nv.url || fileUrl(currentProject, nv.file);
    const resp = await fetch(url);
    if (!resp.ok) throw new Error('HTTP ' + resp.status);
    const md = await resp.text();

    // Store in cache
    const cacheKey = currentProject + '::ln::' + index;
    episodeCache[cacheKey] = md;

    // Re-render the whole novel view with reader
    renderNovelView();
    renderNovelReader(index);
  } catch (e) {
    showError('加载章节失败: ' + escHtml(e.message));
  }
}

function renderNovelReader(index) {
  const nv = currentNovels[index];
  if (!nv) return;
  const cacheKey = currentProject + '::ln::' + index;
  const md = episodeCache[cacheKey] || '';
  if (!md) return;

  const images = currentDetail ? (currentDetail.images || []) : [];
  const fullTitle = nv.title || '第' + (index + 1) + '章';

  const bodyHtml = parseNovelMarkdown(md, index, images);

  let readerHtml = '<div class="novel-reader" id="novelReader" style="font-size:' + (currentFontSize || 16) + 'px">';

  // Font size controls
  readerHtml += '<div class="font-size-controls">' +
    '<button onclick="changeFontSize(-1)">A-</button>' +
    '<span class="font-size-label" id="fontSizeLabel">' + (currentFontSize || 16) + 'px</span>' +
    '<button onclick="changeFontSize(1)">A+</button>' +
    '</div>';

  // Navigation
  readerHtml += '<div class="novel-header"><h2>' + escHtml(fullTitle) + '</h2></div>';
  readerHtml += '<div class="novel-nav">' +
    '<button onclick="loadNovelChapter(' + (index - 1) + ')"' + (index <= 0 ? ' disabled' : '') + '>← 上一章</button>' +
    '<button onclick="loadNovelChapter(' + (index + 1) + ')"' + (index >= currentNovels.length - 1 ? ' disabled' : '') + '>下一章 →</button>' +
    '</div>';

  readerHtml += '<div class="novel-body" id="novelBody">' + bodyHtml + '</div>';

  // Chapter end
  readerHtml += '<div class="novel-chapter-end">—— 本章完 ——</div>';

  readerHtml += '</div>';

  // Insert into the reader area
  const area = document.getElementById('novelReaderArea');
  if (area) {
    area.innerHTML = readerHtml;
  } else {
    // Append to content
    document.getElementById('content').innerHTML += readerHtml;
  }

  // Update active state in novel list
  document.querySelectorAll('.novel-item').forEach((el, i) => {
    el.classList.toggle('active', i === index);
  });

  // Scroll to top of reader
  const reader = document.getElementById('novelReader');
  if (reader) reader.scrollIntoView({ behavior: 'smooth', block: 'start' });

  // Set up reading progress
  setupReadingProgress();
}

let currentFontSize = 16;

function changeFontSize(delta) {
  currentFontSize = Math.max(14, Math.min(28, (currentFontSize || 16) + delta));
  const reader = document.getElementById('novelReader');
  if (reader) reader.style.fontSize = currentFontSize + 'px';
  const label = document.getElementById('fontSizeLabel');
  if (label) label.textContent = currentFontSize + 'px';
}

function parseNovelMarkdown(md, chapterIndex, images) {
  if (!md) return '<p>（空内容）</p>';

  let html = '';
  const lines = md.split('\n');

  let illustCounter = 0;

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    const trimmed = line.trim();

    // Skip H1 (#), --- separators
    if (trimmed.startsWith('# ') || trimmed.startsWith('#　')) continue;
    if (/^---+$/.test(trimmed)) continue;
    if (/^## 章末钩子/.test(trimmed)) continue;
    if (trimmed.startsWith('**故事梗概**') || trimmed.startsWith('**分镜模式**') ||
        trimmed.startsWith('**预计') || trimmed.startsWith('**本集')) continue;

    // ILLUST marker
    const illustMatch = trimmed.match(/<!--\s*ILLUST_(\d+)\s*-->/);
    if (illustMatch) {
      illustCounter = parseInt(illustMatch[1]);
      const imgIdx = chapterIndex * 7 + (illustCounter - 1);
      const safeIdx = Math.min(imgIdx, images.length - 1);
      if (images.length > 0 && safeIdx >= 0 && safeIdx < images.length) {
        const img = images[safeIdx];
        const imgUrl = img.url || (img.path ? thumbUrl(currentProject, img.path, 600, 800) : '');
        if (imgUrl) {
          html += '<div class="novel-illust"><img src="' + escHtml(imgUrl) + '" alt="插图 ' + illustCounter + '" loading="lazy"></div>';
        } else {
          html += '<div class="novel-illust"><div class="illust-placeholder">· · ·</div></div>';
        }
      } else {
        html += '<div class="novel-illust"><div class="illust-placeholder">· · ·</div></div>';
      }
      continue;
    }

    // Blockquote (narration)
    if (trimmed.startsWith('> ')) {
      html += '<div class="novel-narration">' + escHtml(trimmed.slice(2)) + '</div>';
      continue;
    }

    // Dialogue: 「台词」——角色名
    const dialogueMatch = trimmed.match(/^「.+?」——.+$/);
    if (dialogueMatch) {
      html += '<div class="novel-dialogue">' + escHtml(trimmed) + '</div>';
      continue;
    }

    // Plain paragraph
    if (trimmed) {
      html += '<p>' + escHtml(trimmed) + '</p>';
    } else {
      // Empty line = paragraph break
      // Don't add extra <br>, just skip
    }
  }

  return html || '<p>（无内容）</p>';
}

// ============================================================
//  Reading Progress
// ============================================================
function setupReadingProgress() {
  const progressBar = document.getElementById('readingProgressBar');
  if (!progressBar) return;

  const updateProgress = () => {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? Math.min((scrollTop / docHeight) * 100, 100) : 0;
    progressBar.style.width = progress + '%';
  };

  // Remove old listener
  window.removeEventListener('scroll', window._progressHandler);
  window._progressHandler = updateProgress;
  window.addEventListener('scroll', window._progressHandler, { passive: true });
  updateProgress();
}

// ============================================================
//  Back to Top Button
// ============================================================
window.addEventListener('scroll', () => {
  const btn = document.getElementById('backTop');
  if (btn) btn.classList.toggle('visible', window.scrollY > 400);
}, { passive: true });

// ============================================================
//  Refresh
// ============================================================
function refreshAll() {
  episodeCache = {};
  if (currentProject && currentDetail) {
    openProject(currentProject);
  } else {
    showHome();
  }
}

// ============================================================
//  Init
// ============================================================
document.addEventListener('DOMContentLoaded', () => {
  // Unregister any service workers to avoid stale cache issues
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.getRegistrations().then(regs => {
      regs.forEach(r => r.unregister());
    }).catch(() => {});
  }
  showHome();
});
</script>
