      if (currentNovels.length > 0) {
        renderNovelView();
      } else {
        renderComicDetail();
      }
    }
  } else if (mode === 'novel') {
    // Just go home with novel filter
    filterCategory('novel');
  } else {
    filterCategory('comic');
  }
}

